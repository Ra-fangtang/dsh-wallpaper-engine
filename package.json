{
  "name": "dsh-wallpaper-engine",
  "version": "0.3.0",
  "description": "把 Wallpaper Engine 的壁纸接进 DSH 界面背景：跟随 WE 当前壁纸、可挑选已安装壁纸、透明度/模糊/暗化可调；场景（.pkg）壁纸会从中解出真实画面，并与 dsh-claude-style 等整页换肤插件兼容",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "wallpaper-engine",
    "wallpaper",
    "background",
    "theme",
    "skin-compat"
  ],
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.1.7"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ra-fangtang/dsh-wallpaper-engine.git"
  },
  "homepage": "https://github.com/Ra-fangtang/dsh-wallpaper-engine#readme",
  "bugs": {
    "url": "https://github.com/Ra-fangtang/dsh-wallpaper-engine/issues"
  },
  "author": "Ra-fangtang",
  "license": "MIT",
  "scripts": {
    "verify": "node scripts/verify.mjs",
    "release:check": "node scripts/verify.mjs --pack",
    "release": "node scripts/verify.mjs --pack --tag"
  }
}
